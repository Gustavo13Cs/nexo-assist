# Banco de Dados SQLite
DATABASE_URL="file:./dev.db"

# Provedor de LLM (Opcional - caso ausente, o Nexo Assist opera com o motor autônomo baseado nas regras do Anexo A)
GEMINI_API_KEY=""

# Configurações do Sistema
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Simulação de instabilidade do sistema legado de chamados (true para simular falhas transitórias)
SIMULATE_LEGACY_FLAKINESS="false"
